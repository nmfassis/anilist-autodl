#!/data/data/com.termux/files/usr/bin/bash
# anilist-autodl command line helper.
DIR="$HOME/.anilist-autodl"
CONF="${AUTODL_CONFIG:-$HOME/.config/anilist-autodl/config}"
LOG="$HOME/.anime_downloader.log"
OUTLOG="$HOME/.anime_downloader_output.log"
STATE="$HOME/.anime_downloader_state.json"
[ -f "$CONF" ] && . "$CONF"

usage() {
  cat <<TXT
anilist-autodl - auto-download your AniList episodes (Termux)

  anilist-autodl run        check AniList and download now (live output)
  anilist-autodl job        same, but through Android's scheduler (like the automatic runs)
  anilist-autodl status     settings, scheduled job, engine version, last log lines
  anilist-autodl logs       follow the log  (add "full" for the complete output log)
  anilist-autodl update     update the engines now (ani-cli-rs / ani-cli / ani-tupi)
  anilist-autodl doctor     test every engine and show what ani-cli-rs really returns
  anilist-autodl check FILE show the audio/subtitle tracks of a video and whether it would be accepted
  anilist-autodl retry      forget failed episodes so they are retried on the next run
  anilist-autodl config     change settings (re-runs the questions)
  anilist-autodl uninstall  remove it (downloaded episodes are kept)
TXT
}

case "${1:-help}" in
  run)     exec bash "$DIR/run.sh" --foreground ;;
  job)
    net=unmetered; [ "${WIFI_ONLY:-true}" = "false" ] && net=any
    termux-job-scheduler --job-id 2 --script "$DIR/run.sh" --network "$net" \
      --battery-not-low "${BATTERY_NOT_LOW:-true}" \
      && echo "Scheduled. Follow it with: anilist-autodl logs" ;;
  update)  exec bash "$DIR/update.sh" --force ;;
  logs)
    if [ "${2:-}" = "full" ]; then exec tail -n 80 -f "$OUTLOG"; else exec tail -n 40 -f "$LOG"; fi ;;
  retry)
    python3 - "$STATE" <<'PY'
import json, sys
p = sys.argv[1]
try:
    d = json.load(open(p))
except Exception:
    print("Nothing to reset."); sys.exit(0)
n = len(d.get("failures", {}))
d["failures"] = {}
json.dump(d, open(p, "w"))
print(f"Cleared {n} failed episode(s); they will be retried on the next run.")
PY
    ;;
  status)
    echo "AniList user : ${ANILIST_USERNAME:-?}"
    echo "Engines      : ${AUTODL_ENGINE:-?}${AUTODL_BACKUP_ENGINE:+ (backup: $AUTODL_BACKUP_ENGINE)}   Language: ${AUTODL_LANG:-?}   Audio: ${AUDIO:-sub} (fallback: ${AUDIO_FALLBACK:-true})"
    echo "Download dir : ${DOWNLOAD_DIR:-/sdcard/Download/Anime}"
    echo "Schedule     : every ${INTERVAL_MINUTES:-60} min, wifi-only=${WIFI_ONLY:-true}, battery-not-low=${BATTERY_NOT_LOW:-true}"
    echo "Ahead        : ${AHEAD_FINISHED:-3} (finished) / ${AHEAD_AIRING:-1} (airing); retry after ${RETRY_COOLDOWN_HOURS:-6} h"
    for e in "${AUTODL_ENGINE:-}" "${AUTODL_BACKUP_ENGINE:-}"; do
      case "$e" in
        ani-tupi)   echo "ani-tupi     : $(pip show ani-tupi 2>/dev/null | sed -n 's/^Version: //p')   auto-update=${AUTO_UPDATE:-true}" ;;
        ani-cli-rs) echo "ani-cli-rs   : $(ani-cli-rs --version 2>/dev/null | head -n1)" ;;
        ani-cli)    echo "ani-cli      : $(ani-cli -V 2>/dev/null | head -n1)" ;;
      esac
    done
    echo "--- scheduled jobs:"; termux-job-scheduler --pending 2>/dev/null
    echo "--- last log lines:"; tail -n 8 "$LOG" 2>/dev/null ;;
  doctor)    exec python3 "$DIR/fetch_anime.py" --doctor ;;
  check)     [ -n "${2:-}" ] || { echo "Usage: anilist-autodl check FILE"; exit 1; }
             exec python3 "$DIR/fetch_anime.py" --inspect "$2" ;;
  config)    exec bash "$DIR/install.sh" --reconfigure ;;
  uninstall) exec bash "$DIR/install.sh" --uninstall ;;
  help|-h|--help|"") usage ;;
  *) echo "Unknown command: $1"; usage; exit 1 ;;
esac
